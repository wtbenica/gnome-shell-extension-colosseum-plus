{
    "compilerOptions": {
        "module": "ES2022",
        "moduleResolution": "bundler",
        "rootDir": "./src",
        "outDir": "./dist",
        "sourceMap": false,
        "strict": true,
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "types": [
            "@girs/gjs",
            "@girs/gnome-shell/ambient"
        ],
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowJs": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "ambient.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}