{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": false,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "@girs/gjs",
      "@girs/gnome-shell/ambient",
      "@girs/soup-3.0"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "ambient.d.ts"
  ],
  "files": [
    "ambient.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}