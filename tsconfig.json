{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "sourceMap": false,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmitOnError": false
  },
  "include": [
    "src/**/*",
    "ambient.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}