{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmitOnError": false
  },
  "include": [
    "src/**/*",
    "ambient.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}