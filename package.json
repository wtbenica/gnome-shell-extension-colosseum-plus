{
  "name": "gnome-shell-extension-colosseum-plus",
  "version": "1.0.0",
  "description": "A GNOME Shell extension for displaying sports scores and information",
  "homepage": "https://github.com/wtbenica/gnome-shell-extension-colosseum",
  "main": "src/extension.js",
  "scripts": {
    "build": "tsc && (cd src && find . -name '*.js' -exec cp --parents {} ../dist/ \\;)",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts src/**/*.js"
  },
  "type": "module",
  "keywords": [
    "gnome",
    "extension",
    "sports",
    "colosseum"
  ],
  "author": "wtbenica",
  "license": "MIT",
  "dependencies": {
    "@girs/gio-2.0": "^2.86.0-4.0.0-beta.38",
    "@girs/glib-2.0": "^2.86.0-4.0.0-beta.38",
    "@girs/gnome-shell": "^49.0.3",
    "@girs/soup-3.0": "^3.6.5-4.0.0-beta.38",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@girs/gjs": "^4.0.0-beta.38",
    "@types/node": "24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.10.3"
}
