{
  "name": "gnome-shell-extension-colosseum-plus",
  "version": "1.0.0",
  "description": "A GNOME Shell extension for displaying sports scores and information",
  "homepage": "https://github.com/wtbenica/gnome-shell-extension-colosseum",
  "main": "src/extension.js",
  "scripts": {
    "build": "tsc && (cd src && find . -name '*.js' -exec cp --parents {} ../dist/ \\;)",
    "watch": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "type": "module",
  "keywords": [
    "gnome",
    "extension",
    "sports",
    "colosseum"
  ],
  "author": "wtbenica",
  "license": "MIT",
  "dependencies": {
    "@girs/gnome-shell": "49.0.3"
  },
  "devDependencies": {
    "@girs/gjs": "^4.0.0-beta.38",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.10.3"
}
