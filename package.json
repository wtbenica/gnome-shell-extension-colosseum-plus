{
  "name": "gnome-shell-extension-colosseum-plus",
  "version": "1.0.0",
  "description": "A GNOME Shell extension for displaying sports scores and information",
  "homepage": "https://github.com/wtbenica/gnome-shell-extension-colosseum",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc && mkdir -p dist && (cp .env dist/ || true) && cp src/metadata.json dist/ && cp stylesheet.css dist/ && cp -r src/ui dist/ && cp -r src/icon dist/ && (cp -r src/schemas dist/ || true)",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.{ts,js}'"
  },
  "type": "module",
  "keywords": [
    "gnome",
    "extension",
    "sports",
    "colosseum"
  ],
  "author": "wtbenica",
  "license": "MIT",
  "dependencies": {
    "@girs/gnome-shell": "^49.0.3",
    "@girs/soup-3.0": "^3.6.5-4.0.0-beta.38",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@girs/gjs": "^4.0.0-beta.38",
    "@types/node": "24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.10.3"
}
